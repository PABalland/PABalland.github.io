df3 = NULL
setwd("~/Library/CloudStorage/Dropbox/1-asg/1-build/3-projects/6-microsoft-2/1-load/geo/urban/ai/patentscope")
df = read.csv ("2026.csv")
df = subset (df, df$domain == "all")
df = subset (df, df$geo != " (NA)")
df$count_pat = ave(df$count, df$geo, FUN = sum)
df = unique(df[, c("geo", "count_pat")])
df$share_pat = round((df$count_pat/sum(df$count_pat))*100, 2)
df[is.na(df)] <- 0
df$rank_pat <- ave(df$count_pat, FUN = function(x) rank(-x, ties.method = "first"))
df$rank_pat <- as.integer(factor(ave(df$rank_pat, df$geo, FUN = mean), levels = sort(unique(ave(df$rank_pat, df$geo, FUN = mean)))))
df3 = df
setwd("~/Library/CloudStorage/Dropbox/1-asg/1-build/3-projects/6-microsoft-2/1-load/geo/urban/ai/openalex")
df = read.csv ("2026.csv")
df = subset (df, df$domain == "all")
df = subset (df, df$geo != " (NA)")
df$count_pub = ave(df$count, df$geo, FUN = sum)
df = unique(df[, c("geo", "count_pub")])
df$share_pub = round((df$count_pub/sum(df$count_pub))*100, 2)
df[is.na(df)] <- 0
df$rank_pub <- ave(df$count_pub, FUN = function(x) rank(-x, ties.method = "first"))
df$rank_pub <- as.integer(factor(ave(df$rank_pub, df$geo, FUN = mean), levels = sort(unique(ave(df$rank_pub, df$geo, FUN = mean)))))
df3 = merge (df3, df, by = "geo", all = T)
setwd("~/Library/CloudStorage/Dropbox/1-asg/1-build/3-projects/6-microsoft-2/1-load/geo/urban/ai/crunchbase")
