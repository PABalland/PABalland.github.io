df[is.na(df)] <- 0
df$rank_inv <- ave(df$count_inv, FUN = function(x) rank(-x, ties.method = "first"))
df$rank_inv <- as.integer(factor(ave(df$rank_inv, df$geo, FUN = mean), levels = sort(unique(ave(df$rank_inv, df$geo, FUN = mean)))))
df3 = merge (df3, df, by = "geo", all = T)
