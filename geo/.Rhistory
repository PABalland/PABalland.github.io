setwd(paste0(dir, "/2-complexity/geo/", g, "/", d,  "/", data))
df = read.csv(list.files()[which.max(as.numeric(sub(".*-(\\d{4})\\.csv", "\\1", list.files())))]) # read the latest file
df = subset (df, df$domain %in% parents$domain)
df$count_inv = df$count
df$rca_inv = df$rca
df$share_inv = round ((ave(df$count, paste0(df$domain, df$geo), FUN = sum)/ave(df$count, paste0(df$domain), FUN = sum))*100, 2)
df = df[, c("geo", "domain", "count_inv", "rca_inv", "share_inv")]
df$rank_inv <- ave(df$count_inv, df$domain, FUN = function(x) rank(-x, ties.method = "first"))
df$rank_inv <- as.integer(factor(ave(df$rank_inv, df$geo, FUN = mean), levels = sort(unique(ave(df$rank_inv, df$geo, FUN = mean)))))
df3 = merge (df3, df, by = c("geo", "domain"))
df3$domain[df3$domain == "Healthcare and Life Sciences"] = "Healthcare"
df3$domain[df3$domain == "Financial Services"] = "Finance"
df3$rank_all <- df3$rank_inv + df3$rank_pat + df3$rank_pub
df3$rank_all <- as.integer(factor(ave(df3$rank_all, df3$geo, FUN = mean), levels = sort(unique(ave(df3$rank_all, df3$geo, FUN = mean)))))
