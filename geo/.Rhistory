library(ggplot2)
library(scales)
df <- data.frame(
iterations = 1:50,
probability = 0.95^(1:50)
)
ggplot(df, aes(x = iterations, y = probability)) +
geom_line(linewidth = 1.2) +
geom_point(size = 2) +
scale_y_continuous(labels = percent_format(accuracy = 1),
limits = c(0, 1)) +
scale_x_continuous(breaks = seq(0, 50, 5)) +
labs(
x = "Number of iterations",
y = "Probability of success"
) +
theme_minimal(base_size = 14) +
theme(
panel.grid.minor = element_blank(),
axis.title = element_text(face = "bold")
)
library(ggplot2)
library(scales)
df <- data.frame(
iterations = 1:50,
probability = 0.95^(1:50)
)
ggplot(df, aes(x = iterations, y = probability)) +
geom_line(linewidth = 1.2) +
geom_point(size = 2) +
scale_y_continuous(labels = percent_format(accuracy = 1),
limits = c(0, 1)) +
scale_x_continuous(breaks = seq(0, 50, 5)) +
labs(
x = "Number of agentic iterations",
y = "Probability of success"
) +
theme_minimal(base_size = 14) +
theme(
panel.grid.minor = element_blank(),
axis.title = element_text(face = "bold")
)
